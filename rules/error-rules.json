[
  {
    "id": "IGNORE_TRACKERS",
    "description": "Bruit des traceurs et régies publicitaires.",
    "source": "*",
    "urlMatch": "googletagmanager|google-analytics|facebook\\.net|hotjar|doubleclick",
    "verdict": "IGNORE"
  },
  {
    "id": "IGNORE_FAVICON",
    "description": "Échec de favicon, sans impact sur l'affichage.",
    "source": "network",
    "urlMatch": "favicon",
    "verdict": "IGNORE"
  },
  {
    "id": "IGNORE_DEPRECATION",

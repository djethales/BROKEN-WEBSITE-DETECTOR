    "incidentType": "JS_ERROR"
  },
  {
    "id": "HYDRATION_FAILED",
    "description": "Échec d'hydratation.",
    "source": "console",
    "textMatch": "Hydration failed|hydrat.* mismatch",
    "verdict": "BROKEN",
    "incidentType": "JS_ERROR"
  },
  {
    "id": "CSS_MIME",
    "description": "Feuille de style refusée à cause de son type MIME.",
    "source": "console",
    "textMatch": "MIME type .* stylesheet",

    "source": "network",
    "resourceType": "stylesheet",
    "statusMatch": "^[45]|failed",
    "verdict": "BROKEN",
    "incidentType": "CSS_FAILED"
  },
  {
    "id": "JS_FAILED_FIRST_PARTY",

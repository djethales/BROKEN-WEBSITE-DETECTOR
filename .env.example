NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=*
DASHBOARD_BASE_URL=http://localhost:5173

DATABASE_URL=postgresql://monitor:monitor@postgres:5432/monitor?schema=public
REDIS_URL=redis://redis:6379

SITES_ENDPOINT_URL=https://example.test/sites.json
SITES_ENDPOINT_TOKEN=
SITES_FIELD_MAP={"items":"sites","externalId":"id","name":"name","url":"url","sourceStatus":"status","clientName":"client","alertEmails":"contactEmail"}
SOURCE_STATUS_MAP={"active":{"monitoringEnabled":true},"maintenance":{"state":"MAINTENANCE","monitoringEnabled":false},"suspendu":{"state":"MAINTENANCE","monitoringEnabled":false}}
RULES_FILE=rules/error-rules.json

MONITOR_TOKEN=change-me-monitor-token
MONITOR_USER_AGENT=BrokenWebsiteDetector/1.0
VIEWPORTS=desktop
INSPECT_TIMEOUT_MS=25000
INSPECT_CONCURRENCY=10
NETWORKIDLE_CAP_MS=5000
LOG_SETTLE_MS=3000
CAPTURE_WARNINGS=false
MAX_LOG_ENTRIES=80
MAX_LOG_TEXT_LENGTH=500
IGNORED_THIRD_PARTY_DOMAINS=
CRITICAL_THIRD_PARTY_DOMAINS=cdnjs.cloudflare.com,cdn.jsdelivr.net,unpkg.com,ajax.googleapis.com
UNKNOWN_THIRD_PARTY_POLICY=ignore
VISIBLE_TEXT_MIN_LENGTH=20

NOISE_VISITS=3
NOISE_VISIT_INTERVAL_SECONDS=0
JUDGE_ENABLED=false
JUDGE_MODEL=claude-haiku-4-5
JUDGE_DAILY_CALL_LIMIT=50
ANTHROPIC_API_KEY=

MAIL_PROVIDER=console
MAIL_API_KEY=
MAIL_FROM=monitor@localhost
ADMIN_ALERT_EMAIL=admin@example.test
API_TOKEN=change-me-api-token-1234

BATCH_SIZE=10
BATCH_INTERVAL_CRON=*/5 * * * *
SYNC_INTERVAL_CRON=0 * * * *
CHECK_INTERVAL_MINUTES=60
RECHECK_DELAY_MINUTES=2
FAILURE_THRESHOLD=2
CYCLE_STALE_MINUTES=15
CHECK_RETENTION_DAYS=30
BROWSER_RESTART_EVERY=50
